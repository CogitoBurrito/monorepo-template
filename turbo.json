{
  "remoteCache": {
    "teamId": "jonsun",
    "apiUrl": "https://turborepo-remote-cache.jon-sun30.workers.dev"
  },
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "GITHUB_TOKEN",
    "TURBO_TOKEN",
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ACCOUNT_ID",
    "TURBO_TEAM"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "lint",
        "check-types",
        "test",
        "format"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "lint": {},
    "check-types": {},
    "format": {},
    "test": {},
  }
}
